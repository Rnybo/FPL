# Reverse proxy for the FPL backend -- terminates HTTPS via Let's Encrypt
# automatically for the sslip.io hostname (a real public DNS name that maps
# to this VM's own IP, so Let's Encrypt's HTTP-01 challenge succeeds with
# zero manual cert handling and zero domain purchase).
#
# Replace <ip-with-dashes> below with your VM's public IP, dots -> dashes,
# e.g. 143.47.28.10 -> 143-47-28-10
# HTTP/3 (QUIC, over UDP 443) disabled globally -- some networks/routers
# handle it inconsistently, which can surface to browsers as an SSL/cipher
# mismatch even though the underlying TLS 1.2/1.3-over-TCP cert is perfectly
# valid. Plain HTTP/1.1 + HTTP/2 over TCP is more universally reliable for a
# small personal-use API like this. (Global options block -- must come before
# any site address, and "servers" is a global-only directive, not per-site.)
{
    servers {
        protocols h1 h2
    }
}

35-252-212-174.sslip.io {
    reverse_proxy localhost:8000
}
